---
// A kopi cup seen from above. It is the site mark and the lesson node on the path:
// an empty cup is a lesson to do, a full cup is a lesson done.
interface Props {
  /** 0 = empty, 0.5 = started, 1 = full */
  level?: number;
  class?: string;
  size?: number;
}
const { level = 1, class: cls, size = 48 } = Astro.props;
---

<svg class:list={['cup', cls]} viewBox="0 0 48 48" width={size} height={size} aria-hidden="true" focusable="false" data-level={level}>
  <circle class="cup__saucer" cx="23" cy="24" r="21" />
  <rect class="cup__handle" x="33" y="20" width="13" height="8" rx="4" />
  <circle class="cup__body" cx="23" cy="24" r="13.5" />
  <circle class="cup__kopi cup__kopi--half" cx="23" cy="24" r="6" />
  <circle class="cup__kopi cup__kopi--full" cx="23" cy="24" r="10.25" />
  <path class="cup__glint" d="M16.5 21.5a7.5 7.5 0 0 1 6-4.4" />
</svg>

<style is:global>
  .cup__saucer {
    fill: var(--cup-saucer, var(--surface));
    stroke: var(--ink);
    stroke-width: 2;
  }
  .cup__handle,
  .cup__body {
    fill: var(--raised);
    stroke: var(--ink);
    stroke-width: 2;
  }
  .cup__kopi {
    fill: var(--cup-kopi, #4a2c1c);
    opacity: 0;
    transform-origin: 23px 24px;
  }
  .cup__glint {
    fill: none;
    stroke: var(--raised);
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: 0;
  }
  .cup[data-level='0.5'] .cup__kopi--half,
  .cup[data-level='1'] .cup__kopi--full,
  .cup[data-level='1'] .cup__glint {
    opacity: 1;
  }
  :root[data-theme='dark'] .cup {
    --cup-kopi: #c98a5f;
  }
</style>
