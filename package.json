{
  "name": "kopi-academy",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Unofficial guided exam prep for two first-year VU Amsterdam AI courses.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/preload-islands.mjs",
    "build:lab": "sh scripts/build-lab.sh",
    "build:all": "astro build && node scripts/preload-islands.mjs && sh scripts/build-lab.sh",
    "preview": "astro preview",
    "check:videos": "node scripts/check-video-budget.mjs",
    "check:content": "node scripts/check-content.mjs",
    "test": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "walkthrough": "playwright test tests/walkthrough.spec.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.5",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "astro": "^7.4.8",
    "gsap": "^3.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
